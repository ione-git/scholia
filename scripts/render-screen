#!/usr/bin/env swift
import AppKit
import WebKit

struct Canvas: Decodable {
    struct Board: Decodable {
        let w: Double
        let h: Double
    }
    let boards: [String: Board]
}

func fail(_ message: String) -> Never {
    FileHandle.standardError.write(Data("render-screen: \(message)\n".utf8))
    exit(1)
}

let arguments = CommandLine.arguments
guard arguments.count == 3 else {
    fail("usage: scripts/render-screen <Design/canvas/project/Screen.dc.html> <out.png>")
}
let screenURL = URL(fileURLWithPath: arguments[1]).standardizedFileURL
let outputURL = URL(fileURLWithPath: arguments[2]).standardizedFileURL
let canvasURL = screenURL.deletingLastPathComponent().appendingPathComponent("canvas.json")

guard let canvasData = try? Data(contentsOf: canvasURL),
    let canvas = try? JSONDecoder().decode(Canvas.self, from: canvasData)
else { fail("cannot read \(canvasURL.path)") }
guard let board = canvas.boards[screenURL.lastPathComponent] else {
    fail("\(screenURL.lastPathComponent) is not a board in \(canvasURL.path)")
}

let runtime = """
    const host = document.querySelector('x-dc');
    const source = document.querySelector('script[data-dc-script]');
    const helmet = host.querySelector('helmet');
    if (helmet) document.head.append(...helmet.childNodes);
    const template = host.innerHTML;
    const lookup = (path, scope) => path.trim().split('.').reduce((v, k) => (v == null ? undefined : v[k]), scope);
    const inner = (text) => text.replace(/^\\s*\\{\\{|\\}\\}\\s*$/g, '');
    const fill = (text, scope) => text.replace(/\\{\\{([^}]*)\\}\\}/g, (_, path) => {
        const value = lookup(path, scope);
        return value == null ? '' : String(value);
    });
    const expand = (node, scope) => {
        for (const child of [...node.childNodes]) {
            if (child.nodeType === Node.TEXT_NODE) {
                child.data = fill(child.data, scope);
            } else if (child.nodeType !== Node.ELEMENT_NODE) {
                continue;
            } else if (child.localName === 'sc-for') {
                const name = child.getAttribute('as');
                const items = lookup(inner(child.getAttribute('list')), scope) || [];
                const copies = items.map((item) => {
                    const copy = child.cloneNode(true);
                    expand(copy, { ...scope, [name]: item });
                    return [...copy.childNodes];
                });
                child.replaceWith(...copies.flat());
            } else if (child.localName === 'sc-if') {
                if (lookup(inner(child.getAttribute('value')), scope)) {
                    expand(child, scope);
                    child.replaceWith(...child.childNodes);
                } else {
                    child.remove();
                }
            } else {
                for (const attribute of [...child.attributes]) {
                    if (attribute.value.includes('{{')) child.setAttribute(attribute.name, fill(attribute.value, scope));
                }
                expand(child, scope);
            }
        }
    };
    let component = null;
    const render = () => {
        const fragment = document.createElement('template');
        fragment.innerHTML = template;
        expand(fragment.content, component ? component.renderVals() : {});
        host.replaceChildren(fragment.content);
    };
    class DCLogic {
        constructor(props) {
            this.props = props || {};
            this.state = {};
        }
        setState(patch) {
            Object.assign(this.state, typeof patch === 'function' ? patch(this.state, this.props) : patch);
            render();
        }
        renderVals() {
            return {};
        }
    }
    if (source) {
        const Component = new Function('DCLogic', source.textContent + '\\nreturn Component;')(DCLogic);
        component = new Component(JSON.parse(source.dataset.props || '{}'));
    }
    render();
    if (component && component.componentDidMount) component.componentDidMount();
    await document.fonts.ready;
    await new Promise((resolve) => setTimeout(resolve, 1000));
    await document.fonts.ready;
    const literata = [...document.fonts].filter((face) => face.family.replace(/["']/g, '') === 'Literata');
    const missing = literata.length === 0 || literata.some((face) => face.status === 'error');
    return missing ? 'Literata did not load (offline?); serif text uses the Georgia fallback' : '';
    """

final class Renderer: NSObject, WKNavigationDelegate {
    let webView: WKWebView

    init(width: Double, height: Double) {
        let configuration = WKWebViewConfiguration()
        webView = WKWebView(frame: CGRect(x: 0, y: 0, width: width, height: height), configuration: configuration)
        super.init()
        webView.navigationDelegate = self
    }

    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) {
        webView.callAsyncJavaScript(runtime, arguments: [:], in: nil, in: .page) { result in
            switch result {
            case .failure(let error):
                fail("screen script failed: \(error)")
            case .success(let warning):
                if let warning = warning as? String, !warning.isEmpty {
                    FileHandle.standardError.write(Data("render-screen: warning: \(warning)\n".utf8))
                }
                self.snapshot()
            }
        }
    }

    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) {
        fail("load failed: \(error.localizedDescription)")
    }

    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) {
        fail("load failed: \(error.localizedDescription)")
    }

    func snapshot() {
        let configuration = WKSnapshotConfiguration()
        configuration.rect = webView.bounds
        webView.takeSnapshot(with: configuration) { image, error in
            guard let image, let tiff = image.tiffRepresentation, let bitmap = NSBitmapImageRep(data: tiff),
                let png = bitmap.representation(using: .png, properties: [:])
            else { fail("snapshot failed: \(error?.localizedDescription ?? "no image")") }
            do {
                try FileManager.default.createDirectory(
                    at: outputURL.deletingLastPathComponent(), withIntermediateDirectories: true)
                try png.write(to: outputURL)
            } catch {
                fail("cannot write \(outputURL.path): \(error.localizedDescription)")
            }
            print("\(outputURL.path) \(bitmap.pixelsWide)x\(bitmap.pixelsHigh)")
            exit(0)
        }
    }
}

let renderer = Renderer(width: board.w, height: board.h)
renderer.webView.loadFileURL(screenURL, allowingReadAccessTo: screenURL.deletingLastPathComponent())
RunLoop.main.run()
